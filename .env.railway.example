# Railway uygulama servisine kopyalayin: .env.railway
# Sonra: railway login && railway link
#        powershell -ExecutionPolicy Bypass -File ./scripts/railway-deploy.ps1 -Action PushEnv
#
# DATABASE_URL: Dashboard'da Postgres servisinden "Variable Reference" tercih edilir.
# Bu dosyadan push edecekseniz tam postgresql:// URL yapistirin.

DATABASE_URL=postgresql://USER:PASS@HOST:PORT/railway?schema=public
JWT_SECRET=degistirin-en-az-32-karakter-uzunlugunda-rastgele
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
NEXTAUTH_URL=https://your-app.up.railway.app
NODE_ENV=production

